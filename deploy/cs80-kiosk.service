[Unit]
Description=CS80 background renderer (headless Chromium kiosk)
After=cs80-panel.service
Wants=cs80-panel.service

[Service]
Type=simple
Environment=HOME=/root
ExecStartPre=/bin/rm -rf /var/lib/cs80-kiosk
ExecStart=/root/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome --headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --hide-scrollbars --window-size=1280,1000 --no-first-run --no-default-browser-check --user-data-dir=/var/lib/cs80-kiosk http://127.0.0.1:8787/?kiosk=1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
