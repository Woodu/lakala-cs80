[Unit]
Description=CS80 panel host (Linux usbfs)
After=multi-user.target

[Service]
Type=simple
WorkingDirectory=/root/lakala-cs80/panel
ExecStart=/usr/bin/python3 -u host.py --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
