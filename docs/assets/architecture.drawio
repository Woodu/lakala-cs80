<mxfile host="drawio" type="device">
  <diagram id="arch" name="架构">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="hostBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b0b0b0;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="580" height="470" as="geometry" />
        </mxCell>
        <mxCell id="hostTitle" value="主机（macOS / Windows / Linux）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="34" y="26" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="canvas" value="&lt;b&gt;画布 800×1280&lt;/b&gt;&lt;br&gt;编辑器 = 预览 = 设备像素源&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;gridstack 拖拽 · 多画布 · 屏保&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="270" height="86" as="geometry" />
        </mxCell>

        <mxCell id="host" value="&lt;b&gt;host.py&lt;/b&gt;（常驻）&lt;br&gt;HTTP :8787 · 布局 JSON&lt;br&gt;数据源调度 · 屏保 ffmpeg · 音频上传&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;macOS / Windows / Linux 同一份代码&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="196" width="270" height="102" as="geometry" />
        </mxCell>

        <mxCell id="sidecar" value="&lt;b&gt;qdc1&lt;/b&gt;（C sidecar，独占 USB）&lt;br&gt;IOKit / COM / usbfs · QDC1 协议&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;LZ4 · 影子 framebuffer · 自愈重试&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="270" height="92" as="geometry" />
        </mxCell>

        <mxCell id="sources" value="&lt;b&gt;数据源&lt;/b&gt;&lt;br&gt;天气 · 行情（东财/新浪）&lt;br&gt;热榜 12 源 · 假期&lt;br&gt;Agent 会话 · 系统指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="196" width="220" height="102" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="canvas" target="host">
          <mxGeometry relative="1" as="geometry" />
          <mxCell value="tile 差分" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666;" vertex="1" connectable="0" parent="e1">
            <mxGeometry x="-0.2" relative="1" as="geometry" />
          </mxCell>
        </mxCell>
        <mxCell id="e2" value="stdin 二进制：整帧 / patch / 控屏 / 音频" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;fontColor=#666;" edge="1" parent="1" source="host" target="sidecar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="拉取 + 缓存" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;fontColor=#a08b3c;" edge="1" parent="1" source="sources" target="host">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="screenBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b0b0b0;dashed=0;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="700" y="20" width="470" height="470" as="geometry" />
        </mxCell>
        <mxCell id="screenTitle" value="CS80 屏（EC600U + SC7705 面板 800×1280）" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="714" y="26" width="440" height="24" as="geometry" />
        </mxCell>

        <mxCell id="usb" value="USB Type-C（QDC1 协议）&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;整帧 2 MB ≈ 195 ms · 局部 patch 64 B / 1–2 ms&lt;/span&gt;" style="shape=flexArrow;endArrow=block;html=1;fillColor=#666;strokeColor=#333;strokeWidth=1;fontSize=12;verticalAlign=bottom;align=center;labelPosition=center;verticalLabelPosition=top;" edge="1" parent="1">
          <mxGeometry width="60" height="44" relative="1" as="geometry">
            <mxPoint x="620" y="330" as="sourcePoint" />
            <mxPoint x="700" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="f1" value="&lt;b&gt;QDC1 命令解析&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BEGIN / DATA / COMMIT / PATCH&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="70" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;LZ4 解压 / 裸块直收&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;512 KB 一块 · 解码失败自动回退裸块&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="156" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;framebuffer（BGR565）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cache-clean + VERIFY 回读哈希自检&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="242" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;DSI → SC7705 面板&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;背光 / 待机 / 喇叭（MP3 解码在固件里）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="328" width="410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="rules" value="&lt;b&gt;三条设计约束&lt;/b&gt;&lt;br&gt;① 固件 5 s 收不到命令就回「等待连接」页 → 主机必须常驻、保活不断&lt;br&gt;② 屏幕是单缓冲：整帧 LZ4 单块 ≤512 KB，超了固件静默丢包 → 按 512 KB 分块 + 裸块兜底&lt;br&gt;③ 局部 patch 走影子 framebuffer 哈希链，哈希对不上固件直接 BAD_STATE → sidecar 侧维护前一帧哈希" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0b0b0;align=left;verticalAlign=middle;fontSize=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="510" width="1150" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
